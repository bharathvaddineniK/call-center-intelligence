# LLM provider: openai, gemini, or groq
LLM_PROVIDER=openai

# Provider API keys. Fill only the providers you plan to use.
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Optional LangSmith tracing
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=call-center-intelligence
LANGSMITH_PROJECT_URL=https://smith.langchain.com/o/your-org-id/projects/p/your-project-id

# Optional Hugging Face token for model downloads or private assets
HF_TOKEN=your-huggingface-token

# Chat model names
OPENAI_MODEL=gpt-4o
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# Hosted audio fallback model
AUDIO_MODEL_FALLBACK=whisper-large-v3-turbo

# Local cleanup retention for copied audio files
MAX_AUDIO_AGE_HOURS=24
